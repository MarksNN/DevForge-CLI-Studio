# Chaves só no servidor. O navegador recebe apenas se cada uma está configurada.
# Sem a chave, a etapa daquela empresa fica no motor local e diz qual variável falta.
#
# Grok usa a sessão do `grok login` em %USERPROFILE%\.grok\auth.json
# (ou GROK_AUTH_PATH / GROK_HOME). XAI_API_KEY só entra quando essa sessão não existe.

XAI_API_KEY=
XAI_MODEL=grok-4.7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GH_TOKEN=
